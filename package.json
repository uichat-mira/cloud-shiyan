{
  "name": "@uichat-mira/cloud-shiyan",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "types": "wrangler types worker-configuration.d.ts -c wrangler.jsonc",
    "typecheck": "npm run types && tsc -p tsconfig.json",
    "test": "npm run test:unit && npm run test:contract && npm run test:integration",
    "test:unit": "tsx --test tests/stt.test.ts tests/mob020.llm.test.ts",
    "test:contract": "tsx --test tests/mob019.workflow.test.ts tests/mob020.organize.test.ts tests/mob022.destination.test.ts tests/mob022.delivery.test.ts",
    "test:integration": "vitest run --config vitest.config.ts",
    "dry-run": "wrangler deploy --dry-run -c wrangler.jsonc",
    "check": "npm run typecheck && npm test && npm run dry-run"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "2.0.73",
    "ai": "6.0.270"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "^4.1.0",
    "wrangler": "4.79.0"
  }
}
